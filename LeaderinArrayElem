import java.util.*;
public class Main{
    public static void main(String[]args){
        Scanner sc = new Scanner(System.in);
        int n = sc.nextInt();
        int[]arr = new int[n];
        for(int i=0;i<n;i++){
            arr[i] = sc.nextInt();
        }
        String s = "";
        int m = arr[n-1];
        s+=m + " ";
        
        for(int i=n-2;i>=0;i--){
            if(m<arr[i]){
                m=arr[i];
                s+=arr[i] + " ";
            
            }
        }
        String[]sh = s.split(" ");
        for(int i=sh.length-1;i>=0;i--)
        System.out.print(sh[i]+ " ");
    }
}
